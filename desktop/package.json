{
  "name": "jahtaria-visa-desktop",
  "version": "1.0.0",
  "description": "Jahtaria Travel Services — U.S. Visa Intelligence & Document Automation Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cyberrock.jahtaria.visasuite",
    "productName": "Jahtaria Visa Intelligence",
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage"]
    }
  }
}
