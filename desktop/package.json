{
  "name": "jahtaria-visa-desktop",
  "version": "2.4.0",
  "description": "Jahtaria Visa Intelligence Alpha — U.S. Visa Intelligence & Document Automation Desktop App",
  "author": "Jahtaria Travel Services / Cyberrock",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cyberrock.jahtaria.visasuite.alpha",
    "productName": "Jahtaria Visa Intelligence Alpha",
    "artifactName": "Jahtaria-Visa-Intelligence-Alpha-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/webui",
        "to": "webui"
      },
      {
        "from": "resources/seed-data",
        "to": "seed-data"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jahtaria Visa Intelligence",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": ["dmg"]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage"]
    }
  }
}
