# Jahtaria Visa Intelligence & Document Automation
# Copy to .env and customize for your agency

APP_NAME="Jahtaria Travel Services"
APP_TAGLINE="U.S. Visa Preparation & Consular Intelligence"
APP_ENV=desktop

# Database: SQLite by default for zero-setup Desktop; switch to PostgreSQL for VPS
# DATABASE_URL=postgresql://govbot:govbot@db:5432/jamaica_govbot
DATABASE_URL=sqlite:///../data/jamaica_govbot.db

# Security (auto-generated on first desktop boot if left blank)
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ENCRYPTION_KEY=

# Seeded starter accounts (editable in CEO Settings)
SEED_CEO_EMAIL=ceo@jahtariatravel.com
SEED_CEO_PASSWORD=JahtariaCEO2026!
SEED_STAFF_EMAIL=staff@jahtariatravel.com
SEED_STAFF_PASSWORD=JahtariaStaff2026!
SEED_CLIENT_EMAIL=client@jahtariatravel.com
SEED_CLIENT_PASSWORD=JahtariaClient2026!

# AI Provider Defaults (all also configurable via CEO -> Easy Setup UI)
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Optional Integrations (also configurable via CEO -> Easy Setup UI)
COMPOSIO_API_KEY=
COMPANY_DB_URL=

# Ports
BACKEND_PORT=8010
FRONTEND_PORT=3010
NEXT_PUBLIC_API_URL=http://localhost:8010
